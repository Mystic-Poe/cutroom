#!/usr/bin/env node
'use strict';
// Status line for Claude Code. Reads the session JSON on stdin, prints two calm lines:
//   ▸ nike_spot · Resolve ● Timeline v3 · Media 1.2TB free
//     limit 22% · memory 34% · Higgsfield 820 cr
// Never makes a network call. Anything it can't read is left out.
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const lib = path.join(__dirname, '..', 'lib');

const plain = !!process.env.NO_COLOR;
const rgb = (hex) => {
  const n = parseInt(hex.slice(1), 16);
  return `\x1b[38;2;${n >> 16};${(n >> 8) & 255};${n & 255}m`;
};
const paint = (hex, s) => (plain ? s : `${rgb(hex)}${s}\x1b[0m`);
const C = { dim: '#8a857f', text: '#d8d4cf', accent: '#c9a27a', ok: '#8fb894', warn: '#d4a85a', bad: '#d0645a' };
const SEP = paint(C.dim, ' · ');

function main(raw) {
  let data = {};
  try {
    data = JSON.parse(raw);
  } catch { /* print what we can */ }
  const { loadConfig } = require(path.join(lib, 'config'));
  const { file, readJson } = require(path.join(lib, 'home'));
  const jobs = require(path.join(lib, 'jobs'));
  let cfg;
  try {
    cfg = loadConfig();
  } catch {
    cfg = { projectRoots: [], mediaRoots: [] };
  }
  const state = readJson(file('state.json'), {}) || {};
  const now = Date.now();
  const cwd = (data.workspace && (data.workspace.current_dir || data.workspace.project_dir)) || data.cwd || '';

  // ---- line 1: where am I ----
  const one = [];
  const folder = cwd ? path.basename(cwd) : 'cutroom';
  one.push(paint(C.accent, '▸ ') + paint(C.text, folder));

  const procName = process.env.CUTROOM_RESOLVE_PROC || 'Resolve';
  let resolveOpen = false;
  try {
    resolveOpen = spawnSync('pgrep', ['-x', procName], { timeout: 300 }).status === 0;
  } catch { /* unknown */ }
  let r = paint(C.dim, 'Resolve ') + (resolveOpen ? paint(C.ok, '●') : paint(C.dim, '○'));
  const rs = state.resolve || {};
  if (resolveOpen && rs.timeline && now - (rs.updatedAt || 0) < 120e3) r += ' ' + paint(C.text, String(rs.timeline));
  one.push(r);

  const drives = drivesFor([...(cfg.mediaRoots || []), ...(cfg.projectRoots || [])]);
  for (const d of drives) {
    const color = d.freeKb < 20 * 1024 * 1024 ? C.bad : d.freeKb < 100 * 1024 * 1024 ? C.warn : C.dim;
    one.push(paint(C.dim, `${d.label} `) + paint(color, `${human(d.freeKb)} free`));
  }

  // ---- line 2: meters ----
  const two = [];
  const limit = data.rate_limits && data.rate_limits.five_hour && data.rate_limits.five_hour.used_percentage;
  if (typeof limit === 'number') two.push(paint(limit >= 80 ? C.warn : C.dim, `limit ${Math.round(limit)}%`));
  const mem = data.context_window && data.context_window.used_percentage;
  if (typeof mem === 'number') two.push(paint(mem >= 80 ? C.warn : C.dim, `memory ${Math.round(mem)}%`));
  const hf = state.higgsfield || {};
  if (typeof hf.credits === 'number') two.push(paint(hf.credits < 50 ? C.warn : C.dim, `Higgsfield ${hf.credits} cr`));

  // the band normally shows jobs; if it isn't drawing (no mods), show it here
  const bandAlive = Number(readJson(file('band-alive'), 0)) || 0;
  if (now - bandAlive > 15e3) {
    const j = jobs.current(cwd, now);
    if (j) two.push(paint(j.status === 'failed' ? C.bad : C.accent, jobs.line(j)));
  }

  const out = [one.join(SEP)];
  if (two.length) out.push('  ' + two.join(SEP));
  process.stdout.write(out.join('\n') + '\n');
}

function drivesFor(paths) {
  if (!paths.length) return [];
  const r = spawnSync('df', ['-kP', ...paths], { encoding: 'utf8', timeout: 500 });
  if (r.status !== 0 && !r.stdout) return [];
  const seen = new Map();
  for (const lineText of (r.stdout || '').split('\n').slice(1)) {
    const cols = lineText.trim().split(/\s+/);
    if (cols.length < 6) continue;
    const mount = cols.slice(5).join(' ');
    if (seen.has(mount)) continue;
    const label = mount === '/' || mount === '/System/Volumes/Data' ? 'Mac' : path.basename(mount);
    seen.set(mount, { label, freeKb: Number(cols[3]) });
  }
  return [...seen.values()];
}

function human(kb) {
  const gb = kb / 1024 / 1024;
  if (gb >= 1000) return `${(gb / 1024).toFixed(1)}TB`;
  if (gb >= 10) return `${Math.round(gb)}GB`;
  return `${gb.toFixed(1)}GB`;
}

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', (c) => (input += c));
process.stdin.on('end', () => {
  try {
    main(input);
  } catch {
    process.stdout.write('▸ cutroom\n');
  }
});
